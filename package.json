{
  "name": "medusa-payment-peach-payments",
  "version": "0.1.3",
  "description": "Unofficial Peach Payments payment provider for Medusa v2",
  "author": "Max Bissolati",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Max-Bissolati/medusa-payment-peach-payments.git"
  },
  "bugs": {
    "url": "https://github.com/Max-Bissolati/medusa-payment-peach-payments/issues"
  },
  "homepage": "https://github.com/Max-Bissolati/medusa-payment-peach-payments#readme",
  "keywords": [
    "medusa-plugin",
    "medusa-plugin-integration",
    "medusa-plugin-payment",
    "medusa-v2",
    "peach-payments"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    ".medusa/server"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./providers/*": {
      "types": "./.medusa/server/src/providers/*/index.d.ts",
      "default": "./.medusa/server/src/providers/*/index.js"
    },
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    },
    "./*": {
      "types": "./.medusa/server/src/*.d.ts",
      "default": "./.medusa/server/src/*.js"
    }
  },
  "scripts": {
    "build": "medusa plugin:build && tsc -p tsconfig.declarations.json",
    "dev": "medusa plugin:develop",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@medusajs/framework": "^2.13.0",
    "@medusajs/medusa": "^2.13.0"
  },
  "devDependencies": {
    "@medusajs/cli": "2.13.1",
    "@medusajs/framework": "2.13.1",
    "@medusajs/medusa": "2.13.1",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.12.11",
    "jest": "^29.7.0",
    "typescript": "^5.6.2"
  }
}
